rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // MULTI-TENANT GLOBAL HELPERS & ZERO-TRUST SECURITY
    // =========================================================================
    
    function isSignedIn() { return request.auth != null; }
    function isOwner(data) { return isSignedIn() && 'ownerId' in data && data.ownerId == request.auth.uid; }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // =========================================================================
    // CORE APP COLLECTIONS (Authenticated Tenant CRUD)
    // =========================================================================

    // Customers: Full access for signed-in users, tenant isolation preserved by app logic
    match /customers/{docId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Transactions: Full access for signed-in users
    match /transactions/{transactionId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Tenant Settings: Accessible to authenticated users
    match /settings/{userId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Uploaded Data
    match /uploadedData/{uploadId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // WhatsApp Message Records
    match /whatsapp_messages/{messageId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Payment Receipts (Portal public submissions & Tenant review/approval)
    match /payment_receipts/{receiptId} {
      allow read, get, list: if true;
      allow create: if true; // Allows citizens to submit payment screenshots from public portal
      allow update, delete: if isSignedIn(); // Allows authenticated admins to review, approve & reject
    }

    // Complaints (Public portal submission & Tenant review/resolution)
    match /complaints/{complaintId} {
      allow read, get, list: if true;
      allow create: if true; // Allows citizens to submit complaints from public portal
      allow update, delete: if isSignedIn(); // Allows authenticated admins to resolve
    }

    // Complaints Archive
    match /complaints_archive/{complaintId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Billing Audit Logs
    match /billing_audit/{auditId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Reports (Tenant scoped)
    match /reports/{reportId} {
      allow get, list, create, update, delete: if isSignedIn() || ('isPublic' in existing() && existing().isPublic == true);
    }

    // Report Folders
    match /reportFolders/{folderId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Chatbot Settings
    match /chatbotSettings/{userId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Providers (Scoped to tenant)
    match /providers/{providerId} {
      allow read, write: if isSignedIn();
    }

    // Automation Errors: strictly isolated per tenant
    match /automation_errors/{errorId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Public Customer Portals
    match /public_portals/{portalId} {
      allow read: if true;
      allow write: if true;
    }

    // WhatsApp Live Audit Logs
    match /whatsapp_logs/{logId} {
      allow read, list, create, update, delete: if isSignedIn();
    }

    // WhatsApp Template Pruning Audit Logs
    match /template_prune_logs/{logId} {
      allow read, list, create, update, delete: if isSignedIn();
    }

    // Background Jobs: strictly isolated per tenant
    match /background_jobs/{jobId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Idempotency Keys (Financial deduplication records)
    match /idempotency_keys/{keyId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // WhatsApp Message Templates
    match /whatsapp_templates/{templateId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Server-side Billing Automation Sessions
    match /automation_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    // Internal locks and limits (deny direct client modification, fallback to admin)
    match /webhook_dedup/{msgId} {
      allow read, write: if false;
    }
    match /rate_limits/{bucketKey} {
      allow read, write: if false;
    }
    match /distributed_locks/{lockId} {
      allow read, write: if false;
    }
    match /lock/{lockId} {
      allow read, write: if false;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
