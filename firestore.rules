rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // MULTI-TENANT GLOBAL HELPERS & ZERO-TRUST SECURITY
    // =========================================================================
    
    function isSignedIn() { return request.auth != null; }
    function isOwner(data) { return isSignedIn() && 'ownerId' in data && data.ownerId == request.auth.uid; }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Default Deny Everything
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // ENTITY VALIDATORS
    // =========================================================================

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'name', 'status', 'balance', 'ownerId']) &&
             data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             (!('mobileNumber' in data) || data.mobileNumber is string) &&
             data.status in ['Active', 'Suspended', 'Faulty', 'Advance Paid'] &&
             data.balance is number &&
             data.ownerId == request.auth.uid;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'customerId', 'amount', 'transactionId', 'date', 'ownerId']) &&
             data.id is string && data.id.size() <= 64 &&
             data.customerId is string && data.customerId.size() <= 64 &&
             data.amount is number &&
             data.transactionId is string && data.transactionId.size() <= 100 &&
             data.date is string &&
             data.ownerId == request.auth.uid;
    }

    function isValidComplaint(data) {
      return data.keys().hasAll(['id', 'customerId', 'customerName', 'message', 'status', 'createdAt', 'ownerId']) &&
             data.id is string && data.id.size() <= 64 &&
             data.customerId is string && data.customerId.size() <= 64 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.status in ['Pending', 'Resolved'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128;
    }

    function isValidPaymentReceipt(data) {
      return data.keys().hasAll(['id', 'customerId', 'ownerId', 'customerName', 'submittedAt', 'status', 'amount']) &&
             data.id is string && data.id.size() <= 64 &&
             data.customerId is string && data.customerId.size() <= 64 &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.status in ['Pending', 'Approved', 'Rejected'] &&
             data.amount is number && data.amount >= 0 && data.amount <= 1000000 &&
             data.submittedAt is string && data.submittedAt.size() <= 50;
    }

    // =========================================================================
    // STRICT TENANT-ISOLATED COLLECTION RULES
    // =========================================================================

    // Customers: strictly scoped to ownerId for both get and list
    match /customers/{docId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidCustomer(incoming());
      allow update: if isOwner(existing()) && isValidCustomer(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(existing());
    }

    // Transactions: strictly scoped to ownerId
    match /transactions/{transactionId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow update: if isOwner(existing()) && isValidTransaction(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(existing());
    }

    // Tenant Settings: document ID MUST be the user's Auth UID
    match /settings/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn() && userId == request.auth.uid && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && userId == request.auth.uid;
      allow delete: if false;
    }

    // Uploaded Data
    match /uploadedData/{uploadId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing()) && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(existing());
    }

    // WhatsApp Message Records
    match /whatsapp_messages/{messageId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(existing());
    }

    // Payment Receipts (Portal submissions & Tenant review)
    match /payment_receipts/{receiptId} {
      allow get: if isOwner(existing()) || ('portalToken' in existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if (isSignedIn() && incoming().ownerId == request.auth.uid) ||
                      (isValidPaymentReceipt(incoming()) && incoming().status == 'Pending' && incoming().id == receiptId);
      allow update: if isOwner(existing());
      allow delete: if isOwner(existing());
    }

    // Complaints (Public portal submission & Tenant review)
    match /complaints/{complaintId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if (isSignedIn() && incoming().ownerId == request.auth.uid) ||
                      (isValidComplaint(incoming()) && incoming().status == 'Pending' && incoming().id == complaintId);
      allow update: if isOwner(existing());
      allow delete: if isOwner(existing());
    }

    // Complaints Archive
    match /complaints_archive/{complaintId} {
      allow read: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing());
      allow delete: if isOwner(existing());
    }

    // Billing Audit Logs
    match /billing_audit/{auditId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(existing());
    }

    // Reports (Tenant scoped)
    match /reports/{reportId} {
      allow get: if isOwner(existing()) || ('isPublic' in existing() && existing().isPublic == true);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing());
      allow delete: if isOwner(existing());
    }

    // Report Folders
    match /reportFolders/{folderId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing());
      allow delete: if isOwner(existing());
    }

    // Chatbot Settings: document ID MUST be the user's Auth UID
    match /chatbotSettings/{userId} {
      allow read: if (isSignedIn() && userId == request.auth.uid);
      allow write: if isSignedIn() && userId == request.auth.uid;
    }

    // Providers (Scoped to tenant)
    match /providers/{providerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Automation Errors: strictly isolated per tenant
    match /automation_errors/{errorId} {
      allow read: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing());
      allow delete: if isOwner(existing());
    }

    // Public Customer Portals
    match /public_portals/{portalId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing());
      allow delete: if isOwner(existing());
    }

    // Webhook Deduplication (Server Admin SDK only; direct client read/write denied)
    match /webhook_dedup/{msgId} {
      allow read, write: if false;
    }

    // WhatsApp Live Audit Logs
    match /whatsapp_logs/{logId} {
      allow read, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // WhatsApp Template Pruning Audit Logs
    match /template_prune_logs/{logId} {
      allow read, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false; // Only written via Server Admin SDK / Background Daemon
    }

    // Background Jobs: strictly isolated per tenant
    match /background_jobs/{jobId} {
      allow read: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing());
      allow delete: if isOwner(existing());
    }

    // Idempotency Keys (Immutable financial deduplication records)
    match /idempotency_keys/{keyId} {
      allow read: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update, delete: if false; // Immutable once written
    }

    // Rate Limit State (Server Admin SDK only; direct client read/write denied)
    match /rate_limits/{bucketKey} {
      allow read, write: if false;
    }

    // Distributed Locks (Server Admin SDK only; direct client read/write denied)
    match /distributed_locks/{lockId} {
      allow read, write: if false;
    }

    // Cron Job Lock Collection (Server Admin SDK only; direct client read/write denied)
    match /lock/{lockId} {
      allow read, write: if false;
    }

    // Server-side Billing Automation Sessions (Source of truth for cron status & processing state)
    match /automation_sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false; // Only written via Server Admin SDK
    }

    // WhatsApp Message Templates: strictly isolated per tenant
    match /whatsapp_templates/{templateId} {
      allow read: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing()) && incoming().ownerId == request.auth.uid;
      allow delete: if isOwner(existing());
    }
  }
}
